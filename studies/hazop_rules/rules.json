 "worked_examples": [
  {
   "id": "ex-transfer-line-no-flow",
   "context": "hydrocarbon transfer from a settling tank to a reactor by two pumps (one spare), level control valve with bypass, non-return valve",
   "parameter": "flow",
   "guide_word": "NONE",
   "causes": [
    "no hydrocarbon available from storage",
    "transfer pump fails (motor fault, loss of power, corroded impeller)"
   ],
   "consequence": "loss of feed to the reactor",
   "responses_in_source": [
    "ensure good communication with the storage area",
    "install a low level alarm on the settling tank"
   ],
   "sources": [
    "nptel-iitm-lecture-13"
   ]
  },
  {
   "id": "ex-transfer-line-more-flow",
   "context": "same transfer line",
   "parameter": "flow",
   "guide_word": "MORE",
   "causes": [
    "level control valve fails open or is bypassed in error"
   ],
   "consequence": "settling tank overfills",
   "responses_in_source": [
    "install a high level alarm",
    "check the size of the overflow",
    "establish a locking-off procedure for the level control valve bypass when not in use"
   ],
   "sources": [
    "nptel-iitm-lecture-13"
   ]
  },
  {
   "id": "ex-transfer-line-no-flow-closed-valve",
   "context": "same transfer line",
   "parameter": "flow",
   "guide_word": "NONE",
   "causes": [
    "isolation valve or level control valve closed while the pump runs"
   ],
   "consequence": "line subjected to full pump pressure",
   "responses_in_source": [
    "install kickback (minimum flow return) on the pumps"
   ],
   "sources": [
    "nptel-iitm-lecture-13"
   ]
  },
  {
   "id": "ex-transfer-line-more-temperature",
   "context": "same transfer line",
   "parameter": "temperature",
   "guide_word": "MORE",
   "causes": [
    "high temperature in the intermediate storage"
   ],
   "consequence": "higher pressure in the transfer line and settling tank",
   "responses_in_source": [
    "install a warning of high temperature at the intermediate storage"
   ],
   "sources": [
    "nptel-iitm-lecture-13"
   ]
  },
  {
   "id": "ex-cooling-coil-no-flow",
   "context": "exothermic reactor cooled by water through a coil, control valve, controller",
   "parameter": "flow",
   "guide_word": "NONE",
   "causes": [
    "control valve fails closed",
    "plugged cooling coils",
    "cooling water service failure",
    "controller fails and closes the valve",
    "air pressure fails, closing the valve"
   ],
   "consequence": "loss of cooling, possible runaway",
   "responses_in_source": [
    "select a valve that fails open",
    "install a filter with a maintenance procedure",
    "install a cooling water flow meter with a low-flow alarm",
    "install a high temperature alarm to alert the operator",
    "check and monitor the reliability of the water service",
    "place the controller on the critical instrumentation list"
   ],
   "sources": [
    "nptel-iitm-lecture-13"
   ]
  },
  {
   "id": "ex-cooling-coil-more-flow",
   "context": "same cooling coil",
   "parameter": "flow",
   "guide_word": "MORE",
   "causes": [
    "control valve fails open",
    "controller fails and opens the valve"
   ],
   "consequence": "reactor cools, reactant concentration builds, possible runaway on heating",
   "responses_in_source": [
    "instruct operators and update procedures"
   ],
   "sources": [
    "nptel-iitm-lecture-13"
   ]
  },
  {
   "id": "ex-cooling-coil-less-flow",
   "context": "same cooling coil",
   "parameter": "flow",
   "guide_word": "LESS",
   "causes": [
    "partially plugged cooling line",
    "partial water source failure",
    "control valve fails to respond"
   ],
   "consequence": "diminished cooling, possible runaway",
   "responses_in_source": [
    "see the filter, flow meter and alarm responses for no flow",
    "place the valve on the critical instrumentation list"
   ],
   "sources": [
    "nptel-iitm-lecture-13"
   ]
  },
  {
   "id": "ex-cooling-coil-reverse-flow",
   "context": "same cooling coil",
   "parameter": "flow",
   "guide_word": "REVERSE",
   "causes": [
    "failure of the water source resulting in backflow",
    "backflow due to high back pressure"
   ],
   "consequence": "loss of cooling, possible runaway",
   "responses_in_source": [
    "install a check valve"
   ],
   "sources": [
    "nptel-iitm-lecture-13"
   ]
  },
  {
   "id": "ex-cooling-coil-more-temperature",
   "context": "same cooling coil",
   "parameter": "temperature",
   "guide_word": "MORE",
   "causes": [
    "high water supply temperature when cooling capacity is limited"
   ],
   "consequence": "cooling system capacity limited, temperature increases",
   "responses_in_source": [
    "install a high flow alarm and/or a cooling water high temperature alarm"
   ],
   "sources": [
    "nptel-iitm-lecture-13"
   ]
  },
  {
   "id": "ex-stirrer-no-agitation",
   "context": "stirrer of the same reactor",
   "parameter": "agitation",
   "guide_word": "NONE",
   "causes": [
    "stirrer motor malfunction",
    "power failure"
   ],
   "consequence": "no mixing, possible accumulation of unreacted materials",
   "responses_in_source": [
    "interlock with the feed line",
    "monomer feed valve must fail closed on loss of power"
   ],
   "sources": [
    "nptel-iitm-lecture-13"
   ]
  }
 ],
 "method_notes": [
  {
   "id": "consequences-without-safeguards",
   "text": "Consequences are written assuming the existing safeguards are not working.",
   "sources": [
    "safeche-hazop-tutorial"
   ]
  },
  {
   "id": "safeguards-are-not-recommendations",
   "text": "Safeguards are protections in place; recommendations are protections to be added.",
   "sources": [
    "safeche-hazop-tutorial"
   ]
  },
  {
   "id": "not-considered",
   "text": "Not considered in a HAZOP: simultaneous unrelated incidents, simultaneous failure of more than one independent protection, natural calamity, sabotage.",
   "sources": [
    "safeche-hazop-tutorial"
   ]
  },
  {
   "id": "known-weaknesses",
   "text": "HAZOP does not identify all causes, takes little account of probabilities, is poor where multiple-combination events matter, and tends to ignore operator intervention.",
   "sources": [
    "nptel-iitm-lecture-13"
   ]
  },
  {
   "id": "identifying-technique",
   "text": "HAZOP identifies hazards; it is not a means of solving problems.",
   "sources": [
    "nptel-iitm-lecture-13"
   ]
  }
 ]
